# Large challenge data — never commit (>100 MB files, not redistributable)
DATA/**/*.tsv
DATA/**/*.zip
DATA/__MACOSX/

# OS junk
**/.DS_Store

# Python / environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated caches
tools/eda_cache/
graphify-out/cache/
graphify-out/.graphify_*

# NOTE: output/**/*.tsv are intentionally committed (via Git LFS) so the validated
# submission survives without re-running the Kaggle pipeline. Everything below is
# excluded because it is regenerable and/or embeds non-redistributable challenge data.

# Regenerable / non-redistributable outputs and heavy inputs (see docs/REPOSITORY_GUIDE.md)
# artifacts/ holds derived parquet caches that embed cleaned raw records.
artifacts/
submission/staging/
kaggle/staging/
